import argparse
import hashlib
import math
import re
import sys

COMMON_PASSWORDS = {
    "123456", "123456789", "password", "12345678", "qwerty", "123456",
    "111111", "12345", "abc123", "1234567", "password1", "iloveyou",
    "admin", "welcome", "monkey", "dragon", "letmein", "football",
    "passw0rd", "p@ssw0rd", "qwerty123", "000000", "1q2w3e4r",
}

KEYBOARD_WALKS = ["qwerty", "asdf", "zxcv", "qazwsx", "1qaz", "12345", "09876"]

# Common base words that people pad with a digit/symbol (e.g. "Password1!").
# Entropy-by-charset alone can't see this pattern, so we check it explicitly.
COMMON_BASE_WORDS = {
    "password", "admin", "welcome", "login", "letmein", "monkey",
    "dragon", "football", "baseball", "master", "sunshine", "princess",
    "iloveyou", "qwerty", "trustno1", "shadow", "freedom", "whatever",
}


def shannon_entropy_bits(password: str) -> float:
    """Estimate bits of entropy based on character-set size used.

    This mirrors the standard 'pool size' entropy estimate:
    bits = length * log2(pool_size)
    """
    pool = 0
    if re.search(r"[a-z]", password):
        pool += 26
    if re.search(r"[A-Z]", password):
        pool += 26
    if re.search(r"[0-9]", password):
        pool += 10
    if re.search(r"[^a-zA-Z0-9]", password):
        pool += 32  # rough count of common symbols

    if pool == 0:
        return 0.0
    return len(password) * math.log2(pool)


def has_sequential_run(password: str, run_len: int = 3) -> bool:
    """Detect runs like 'abc', '123', 'cba', '321'."""
    lower = password.lower()
    for i in range(len(lower) - run_len + 1):
        window = lower[i:i + run_len]
        codes = [ord(c) for c in window]
        if all(codes[j] + 1 == codes[j + 1] for j in range(len(codes) - 1)):
            return True
        if all(codes[j] - 1 == codes[j + 1] for j in range(len(codes) - 1)):
            return True
    return False


def has_repeated_chars(password: str, run_len: int = 3) -> bool:
    """Detect runs like 'aaa', '111'."""
    for i in range(len(password) - run_len + 1):
        if len(set(password[i:i + run_len])) == 1:
            return True
    return False


def has_common_base_word(password: str) -> bool:
    """Catch 'Password1!' style: a dictionary word padded with
    digits/symbols at the start or end. Strips leading/trailing
    non-letters and checks the remaining core word."""
    core = re.sub(r"^[^a-zA-Z]+|[^a-zA-Z]+$", "", password).lower()
    return core in COMMON_BASE_WORDS


def rule_checks(password: str) -> dict:
    return {
        "length_ok (>=8)": len(password) >= 8,
        "has_upper": bool(re.search(r"[A-Z]", password)),
        "has_lower": bool(re.search(r"[a-z]", password)),
        "has_digit": bool(re.search(r"[0-9]", password)),
        "has_symbol": bool(re.search(r"[^a-zA-Z0-9]", password)),
    }


def pwned_count(password: str) -> int | None:
    """Check Have I Been Pwned via k-anonymity. Returns breach count,
    or None if offline / requests not installed / lookup failed.
    Only the first 5 hex chars of the SHA-1 hash are sent -- the full
    password never leaves this machine."""
    try:
        import requests
    except ImportError:
        print("[WARN] 'requests' not installed, skipping breach check. pip install requests")
        return None

    sha1 = hashlib.sha1(password.encode("utf-8")).hexdigest().upper()
    prefix, suffix = sha1[:5], sha1[5:]
    try:
        resp = requests.get(f"https://api.pwnedpasswords.com/range/{prefix}", timeout=5)
        resp.raise_for_status()
    except Exception as e:
        print(f"[WARN] Breach check failed ({e}), skipping.")
        return None

    for line in resp.text.splitlines():
        hash_suffix, count = line.split(":")
        if hash_suffix == suffix:
            return int(count)
    return 0


def evaluate(password: str, username: str | None = None, check_breach: bool = False):
    rules = rule_checks(password)
    entropy = shannon_entropy_bits(password)

    findings = []
    score = sum(rules.values())  # 0-5 baseline from rules, same spirit as the original

    lowered = password.lower()

    if lowered in COMMON_PASSWORDS:
        score = 0
        findings.append("❌ This is one of the most common leaked passwords on earth.")

    if has_common_base_word(password):
        score = min(score, 1)
        entropy = min(entropy, 25.0)  # pattern makes it far weaker than raw charset math suggests
        findings.append("❌ Dictionary word padded with a digit/symbol (e.g. 'Password1!') -- "
                         "crackers try this pattern first, charset size doesn't save it.")

    if any(walk in lowered for walk in KEYBOARD_WALKS):
        score -= 2
        findings.append("⚠️  Contains a keyboard-walk pattern (e.g. qwerty, 12345).")

    if has_sequential_run(password):
        score -= 1
        findings.append("⚠️  Contains a sequential run (abc, 123, etc.).")

    if has_repeated_chars(password):
        score -= 1
        findings.append("⚠️  Contains 3+ repeated characters in a row.")

    if username and username.lower() in lowered:
        score -= 2
        findings.append("❌ Password contains the username -- very guessable.")

    breach_count = None
    if check_breach:
        breach_count = pwned_count(password)
        if breach_count:
            score = 0
            findings.append(f"❌ Found in {breach_count:,} known data breaches (HIBP).")
        elif breach_count == 0:
            findings.append("✅ Not found in the HIBP breach database.")

    # Entropy-based rating takes priority -- it's the real security signal.
    if entropy < 28 or score <= 0:
        rating = "Weak"
    elif entropy < 60:
        rating = "Moderate"
    else:
        rating = "Strong"

    return {
        "rules": rules,
        "entropy_bits": round(entropy, 1),
        "rating": rating,
        "findings": findings,
        "breach_count": breach_count,
    }


def print_report(password: str, result: dict):
    print(f"\nPassword: {'*' * len(password)}  (length {len(password)})")
    print("-" * 50)
    for rule, passed in result["rules"].items():
        print(f"  {'✅' if passed else '❌'} {rule}")
    print(f"\n  Entropy estimate : {result['entropy_bits']} bits")
    print(f"  Rating           : {result['rating']}")
    if result["findings"]:
        print("\n  Notes:")
        for f in result["findings"]:
            print(f"    {f}")
    print("-" * 50)
    if result["rating"] != "Strong":
        print("  Tip: longer random passphrases (4+ random words) beat")
        print("  'Password1!'-style patterns almost every time.\n")


def main():
    p = argparse.ArgumentParser(description="Password Strength Checker (Pro)")
    p.add_argument("-p", "--password", required=True, help="Password to evaluate")
    p.add_argument("-u", "--username", default=None, help="Username, to flag passwords containing it")
    p.add_argument("--check-breach", action="store_true",
                   help="Check against Have I Been Pwned (k-anonymity, needs internet)")
    args = p.parse_args()

    result = evaluate(args.password, args.username, args.check_breach)
    print_report(args.password, result)


if __name__ == "__main__":
    main()
